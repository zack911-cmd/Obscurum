{
  "name": "obscurum",
  "private": true,
  "version": "1.0.0",
  "description": "Obscurum — AI Pentest Platform for ethical hacking",
  "author": "Zack",
  "homepage": "https://github.com/zack/obscurum",
  "desktopName": "Obscurum.desktop",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder --linux --win --mac",
    "electron:build:linux": "npm run build && electron-builder --linux",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@xenova/transformers": "^2.0.1",
    "@xyflow/react": "^12.11.0",
    "axios": "^1.17.0",
    "lucide-react": "^1.23.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.17.0",
    "reactflow": "^11.11.4",
    "systeminformation": "^5.33.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.0.1",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "wait-on": "^9.0.0"
  },
  "build": {
    "appId": "com.obscurum.pentest",
    "productName": "Obscurum",
    "copyright": "Copyright © 2025 Zack",
    "asarUnpack": [
      "build/icons/**/*"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icons/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Security",
      "description": "Obscurum — AI Pentest Platform",
      "maintainer": "Zack",
      "icon": "build/icons/linux",
      "executableName": "obscurum"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icons/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icons/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "deb": {
      "packageCategory": "net",
      "priority": "optional",
      "depends": [
        "libnotify4",
        "libxtst6",
        "libnss3",
        "curl"
      ]
    }
  }
}
